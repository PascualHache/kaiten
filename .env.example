# Sentry — monitorización de errores (ver src/instrument.ts)

# Público, viaja en el bundle. Vacío = Sentry apagado.
VITE_SENTRY_DSN=
# SHA del commit desplegado. En Vercel se coge solo de $VERCEL_GIT_COMMIT_SHA.
VITE_SENTRY_RELEASE=

# Solo para el build: suben los source maps y luego se borran de /dist.
# SECRETO — nunca en el repo, solo en las variables de entorno de Vercel.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ameba-i7
SENTRY_PROJECT=kaiten
